{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/llm/complete",
      "destination": "/api/llm/complete"
    },
    {
      "source": "/api/v1/llm/health",
      "destination": "/api/llm/health"
    }
  ]
}
